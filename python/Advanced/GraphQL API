# Override mutation to send notifications
@strawberry.mutation
class CustomMutation(Mutation):
    @strawberry.mutation
    def create_post(self, title: str, content: str, author_id: str) -> Post:
        post = db.create_post(title, content, author_id)
        # Notify subscribers
        notify_post_created(post)
        return post

# Update schema with custom mutation
schema = strawberry.Schema(query=Query, mutation=CustomMutation, subscription=Subscription)
graphql_app = GraphQLRouter(schema)
app.include_router(graphql_app, prefix="/graphql")

